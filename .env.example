# Ella voice agent: environment variables
# Copy to .env (never commit .env). The same values go into Vercel's
# environment variables for the deployed app (scripts/push-env does this).
# Values marked "generated" are random strings; make them with
#   node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"

# --- Vapi (dashboard.vapi.ai > Organisation > API Keys) -------------------
VAPI_PRIVATE_KEY=            # server-side only: provisioning, test harness and the dashboard's Run tests button
NEXT_PUBLIC_VAPI_PUBLIC_KEY= # browser "Talk to Ella" button; restrict to the dashboard domain
VAPI_WEBHOOK_SECRET=         # generated: Vapi sends it as x-vapi-secret, webhooks reject anything else

# --- Supabase (supabase.com > project > Project Settings > API / Database) -
NEXT_PUBLIC_SUPABASE_URL=       # https://<ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=  # anon / publishable key: dashboard reads via RLS
SUPABASE_SERVICE_ROLE_KEY=      # service_role / secret key: server-side writes only
SUPABASE_DB_URL=                # Connect > Session pooler URI, pasted as is, with [YOUR-PASSWORD] left in it
SUPABASE_DB_PASSWORD=           # the database password; scripts put it into the URI (and encode symbols like @)

# --- HubSpot (Development > Legacy apps > Create a service key) ----------
# Scopes: crm.objects.contacts.read/write, tickets (plus task and note scopes if offered)
HUBSPOT_PRIVATE_APP_TOKEN=

# --- Cal.com (Settings > Developer > API keys) -----------------------------
CALCOM_API_KEY=
CALCOM_EVENT_TYPE_ID=        # numeric ID of the "Free roof inspection" event type

# --- Twilio TEST credentials only (Console > Account > API keys & tokens > Test credentials)
# Live SMS is deliberately not used (US A2P 10DLC registration; see README).
TWILIO_TEST_ACCOUNT_SID=
TWILIO_TEST_AUTH_TOKEN=

# --- ntfy push alerts ------------------------------------------------------
NTFY_SERVER=https://ntfy.sh
NTFY_TOPIC=                  # generated: long, unguessable; subscribe to it in the ntfy phone app

# --- Deployed app ----------------------------------------------------------
PUBLIC_BASE_URL=             # e.g. https://ella-jrco.vercel.app (Vapi tools call <this>/api/vapi/...)
DASHBOARD_ADMIN_PASSCODE=    # generated: unlocks the Tests page's Run tests button (each run spends Vapi credit); leave empty to switch it off

# --- Which client config to provision/serve -------------------------------
CLIENT_ID=jrco
